# ---- TigerGraph (local Community Edition defaults; for Savanna use your workspace host + credentials)
TG_HOST=http://localhost
TG_GRAPHNAME=Verdict
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_RESTPP_PORT=14240
TG_GS_PORT=14240
# TG_API_TOKEN=            # Savanna: optional token instead of username/password
# Optional least-privilege user for the investigator (read-only role); falls back to TG_USERNAME
# TG_INVESTIGATOR_USERNAME=
# TG_INVESTIGATOR_PASSWORD=

# ---- LLM (Claude). Leave the key empty to run fully offline with deterministic templates.
ANTHROPIC_API_KEY=
VERDICT_LLM=auto                 # auto | anthropic | offline
VERDICT_MODEL=claude-opus-5
VERDICT_WORKER_MODEL=claude-haiku-4-5
VERDICT_MAX_TOOL_CALLS=8

# ---- Agent
VERDICT_GRAPH_ACCESS=mcp         # mcp (official tigergraph-mcp, read-only filter) | direct (pyTigerGraph)
# VERDICT_DATA_DIR=data/hhgoa    # default: data/hhgoa if it exists, else data/synthetic
VERDICT_EMBEDDER=lsa             # lsa (offline) | fastembed (BAAI/bge-small-en-v1.5)
