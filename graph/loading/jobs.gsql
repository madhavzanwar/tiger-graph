USE GRAPH Verdict
CREATE LOADING JOB load_customers FOR GRAPH Verdict {
  DEFINE FILENAME f;
  LOAD f TO VERTEX Customer VALUES ($"customer_id", $"home_region", $"first_seen", $"n_txn", $"amt_mean", $"amt_std", $"amt_p95", $"online_ratio", _),
         TO EDGE HOME_REGION VALUES ($"customer_id", $"home_region") WHERE $"home_region" != ""
  USING header="true", separator=",", QUOTE="double";
}
CREATE LOADING JOB load_cards FOR GRAPH Verdict {
  DEFINE FILENAME f;
  LOAD f TO VERTEX Card VALUES ($"card_id", $"customer_id", $"card1", $"card2", $"card3", $"card4", $"card5", $"card6", _, _, _),
         TO EDGE HAS_CARD VALUES ($"customer_id", $"card_id")
  USING header="true", separator=",", QUOTE="double";
}
CREATE LOADING JOB load_devices FOR GRAPH Verdict {
  DEFINE FILENAME f;
  LOAD f TO VERTEX Device VALUES ($"device_key", $"device_type", $"device_info", $"os", $"browser", $"screen", _, _)
  USING header="true", separator=",", QUOTE="double";
}
CREATE LOADING JOB load_txns FOR GRAPH Verdict {
  DEFINE FILENAME f;
  LOAD f TO VERTEX Transaction VALUES ($"txn_id", $"ts", $"amount", $"product_cd", $"channel", $"is_online", $"risk_score", $"dist1", $"m_flags", $"m_fail", $"is_proxy", $"device_new", $"customer_id", $"card_id"),
         TO EDGE MADE VALUES ($"customer_id", $"txn_id"),
         TO EDGE PAID_WITH VALUES ($"txn_id", $"card_id"),
         TO EDGE USED_DEVICE VALUES ($"txn_id", $"device_key") WHERE $"device_key" != "",
         TO EDGE PURCHASER_EMAIL VALUES ($"txn_id", $"p_email") WHERE $"p_email" != "",
         TO EDGE RECIPIENT_EMAIL VALUES ($"txn_id", $"r_email") WHERE $"r_email" != "",
         TO EDGE BILLED_IN VALUES ($"txn_id", $"region_key") WHERE $"region_key" != ""
  USING header="true", separator=",", QUOTE="double";
}
CREATE LOADING JOB load_cases FOR GRAPH Verdict {
  DEFINE FILENAME f;
  LOAD f TO VERTEX FraudCase VALUES ($"case_id", $"source", $"trigger_type", $"status", $"opened_at", $"closed_at", $"outcome", $"pattern", $"evidence_requested", $"evidence_result", $"actions_taken", $"sar_filed", _, _, _, _, $"summary", $"closed_at"),
         TO EDGE CASE_CUSTOMER VALUES ($"case_id", $"customer_id") WHERE $"customer_id" != ""
  USING header="true", separator=",", QUOTE="double";
}
CREATE LOADING JOB load_case_txn FOR GRAPH Verdict {
  DEFINE FILENAME f;
  LOAD f TO EDGE CASE_TXN VALUES ($"case_id", $"txn_id", $"role") USING header="true", separator=",", QUOTE="double";
}
CREATE LOADING JOB load_case_card FOR GRAPH Verdict {
  DEFINE FILENAME f;
  LOAD f TO EDGE CASE_CARD VALUES ($"case_id", $"card_id", $"role") USING header="true", separator=",", QUOTE="double";
}
