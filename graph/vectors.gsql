USE GLOBAL
CREATE GLOBAL SCHEMA_CHANGE JOB verdict_add_vectors {
  ALTER VERTEX DocChunk ADD VECTOR ATTRIBUTE emb(DIMENSION=128, METRIC="COSINE");
  ALTER VERTEX FraudCase ADD VECTOR ATTRIBUTE emb(DIMENSION=128, METRIC="COSINE");
}
RUN GLOBAL SCHEMA_CHANGE JOB verdict_add_vectors
DROP JOB verdict_add_vectors
